          ],
          "text": "Thank you for referring this 10-month-old male who presented with a 3-day history of coryza, worsening cough, noisy breathing, poor feeding, and fewer wet nappies, and was admitted with a diagnosis of bronchiolitis.",
          "unverified_fact_ids": []
        },
