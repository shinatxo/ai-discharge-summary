          "fact_ids": [
            "age_sex.0",
            "presenting_complaint.0",
            "diagnosis_primary.0"
          ],
          "text": "This 58-year-old female was admitted on 02/04 with necrotising soft-tissue infection of the left thigh and septic shock, requiring ITU-level care (inferred — not documented, confirm).",
          "unverified_fact_ids": []
        },
        {
