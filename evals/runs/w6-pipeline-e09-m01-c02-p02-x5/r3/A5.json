          ],
          "text": "Thank you for referring this 76-year-old male who was admitted on 08/05 with a 4-day history of productive cough, fever and breathlessness, and was diagnosed with community-acquired pneumonia (CAP), CURB-65 score 3.",
          "unverified_fact_ids": []
        },
