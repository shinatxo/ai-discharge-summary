          "fact_ids": [
            "age_sex.0",
            "presenting_complaint.0",
            "diagnosis_primary.0"
          ],
          "text": "Thank you for accepting this 70-year-old female who presented with a 2-day history of melaena, one episode of coffee-ground vomit, and dizziness, and was found to have a bleeding duodenal ulcer (Forrest IIa) with H. pylori positivity.",
          "unverified_fact_ids": []
        },
        {
